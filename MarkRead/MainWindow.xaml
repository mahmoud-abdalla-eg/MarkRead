<Window x:Class="MarkRead.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="MarkRead - Modern Markdown Viewer"
        Height="780" Width="1100"
        MinHeight="450" MinWidth="650"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        PreviewDragOver="Window_PreviewDragOver"
        Drop="Window_Drop"
        KeyDown="Window_KeyDown"
        Background="#09090B"
        Foreground="#F4F4F5"
        FontFamily="-apple-system, BlinkMacSystemFont, 'Segoe UI', 'Noto Sans', Helvetica, Arial, sans-serif">

    <Window.Resources>
        <!-- Modern ScrollViewer style for tab bar -->
        <Style x:Key="TabScrollViewerStyle" TargetType="{x:Type ScrollViewer}">
            <Setter Property="HorizontalScrollBarVisibility" Value="Hidden"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollViewer}">
                        <ScrollContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Tab Button Style -->
        <Style x:Key="TabItemButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#121215"/>
            <Setter Property="Foreground" Value="#A1A1AA"/>
            <Setter Property="BorderThickness" Value="1,1,1,0"/>
            <Setter Property="BorderBrush" Value="#27272A"/>
            <Setter Property="Padding" Value="12,6,8,6"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TabBorder" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6,6,0,0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#18181B"/>
                                <Setter Property="Foreground" Value="#F4F4F5"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#3F3F46"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Active Tab Button Style -->
        <Style x:Key="ActiveTabItemButtonStyle" TargetType="Button" BasedOn="{StaticResource TabItemButtonStyle}">
            <Setter Property="Background" Value="#18181B"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Toolbar Button Style -->
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#121215"/>
            <Setter Property="Foreground" Value="#E4E4E7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#27272A"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#27272A"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#3F3F46"/>
                                <Setter Property="Foreground" Value="#FAFAFA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#3F3F46"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Toolbar Button Style (Export PDF / Highlight action) -->
        <Style x:Key="PrimaryToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
            <Setter Property="Background" Value="#27272A"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="Foreground" Value="#FAFAFA"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#3F3F46"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#52525B"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#52525B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Header & Toolbar -->
            <RowDefinition Height="Auto"/>
            <!-- In-Page Search Bar (collapsible) -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content Area (WebView2 & Empty State) -->
            <RowDefinition Height="*"/>
            <!-- Status Bar -->
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- Top Header & Tabs Bar -->
        <Border Grid.Row="0" Background="#09090B" BorderBrush="#27272A" BorderThickness="0,0,0,1" Padding="12,10,12,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 1: App Brand + Global Controls -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- App Title / Logo -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,16,0">
                        <Border Width="26" Height="26" CornerRadius="6" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" Margin="0,0,10,0">
                            <TextBlock Text="M↓" Foreground="#FAFAFA" FontWeight="Bold" FontSize="13" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="MarkRead" Foreground="#FAFAFA" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Quick Toolbar Controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Open File -->
                        <Button Style="{StaticResource ToolbarButtonStyle}" Click="BtnOpen_Click" ToolTip="Open Markdown File (Ctrl+O)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📁 " FontSize="12"/>
                                <TextBlock Text="Open" FontSize="12"/>
                            </StackPanel>
                        </Button>

                        <!-- Toggle Raw / Rendered -->
                        <Button x:Name="BtnToggleRaw" Style="{StaticResource ToolbarButtonStyle}" Click="BtnToggleRaw_Click" ToolTip="Toggle Raw / Rendered Mode (Ctrl+U)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="TxtToggleRawIcon" Text="📄 " FontSize="12"/>
                                <TextBlock x:Name="TxtToggleRaw" Text="Raw" FontSize="12"/>
                            </StackPanel>
                        </Button>

                        <!-- Theme Toggle -->
                        <Button x:Name="BtnThemeToggle" Style="{StaticResource ToolbarButtonStyle}" Click="BtnThemeToggle_Click" ToolTip="Toggle Dark / Light Theme">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="TxtThemeIcon" Text="🌙 " FontSize="12"/>
                                <TextBlock x:Name="TxtTheme" Text="Dark" FontSize="12"/>
                            </StackPanel>
                        </Button>

                        <!-- Export to PDF (Prominent mdtopdf-style button) -->
                        <Button Style="{StaticResource PrimaryToolbarButtonStyle}" Click="BtnExportPdf_Click" ToolTip="Export Clean PDF Document without browser headers (Ctrl+P)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📥 " FontSize="12"/>
                                <TextBlock Text="Export PDF" FontSize="12"/>
                            </StackPanel>
                        </Button>

                        <!-- Search -->
                        <Button Style="{StaticResource ToolbarButtonStyle}" Click="BtnSearch_Click" ToolTip="Find in Document (Ctrl+F)">
                            <TextBlock Text="🔍" FontSize="12"/>
                        </Button>

                        <!-- Settings / Windows Integration -->
                        <Button Style="{StaticResource ToolbarButtonStyle}" Click="BtnSettings_Click" ToolTip="Settings &amp; Windows Shell Integration">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙️ " FontSize="12"/>
                                <TextBlock Text="Settings" FontSize="12"/>
                            </StackPanel>
                        </Button>

                        <!-- Exit App Completely -->
                        <Button Style="{StaticResource ToolbarButtonStyle}" Click="BtnExit_Click" ToolTip="Quit MarkRead completely (Ctrl+Q)" Margin="6,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✕ " Foreground="#F87171" FontWeight="Bold" FontSize="11"/>
                                <TextBlock Text="Exit" FontSize="12"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Row 2: Tab Strip -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ScrollViewer Grid.Column="0" Style="{StaticResource TabScrollViewerStyle}" HorizontalScrollBarVisibility="Auto">
                        <StackPanel x:Name="TabsContainer" Orientation="Horizontal"/>
                    </ScrollViewer>

                    <!-- New Tab Button -->
                    <Button Grid.Column="1" Style="{StaticResource ToolbarButtonStyle}" Margin="4,0,0,0" Padding="8,4" 
                            Click="BtnNewTab_Click" ToolTip="New Tab / Open Document (Ctrl+T)">
                        <TextBlock Text="＋" FontWeight="Bold" FontSize="13"/>
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <!-- Search Bar (Ctrl+F) -->
        <Border x:Name="SearchBar" Grid.Row="1" Background="#121215" BorderBrush="#27272A" BorderThickness="0,0,0,1" 
                Padding="14,8" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Find:" Foreground="#A1A1AA" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold" FontSize="12"/>
                <TextBox x:Name="SearchInput" Grid.Column="1" Background="#18181B" Foreground="#FAFAFA" BorderBrush="#27272A" 
                         Padding="8,4" FontSize="13" KeyDown="SearchInput_KeyDown"/>
                
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                    <Button Style="{StaticResource ToolbarButtonStyle}" Content="Previous" Margin="2,0" Padding="8,4" Click="BtnFindPrev_Click"/>
                    <Button Style="{StaticResource ToolbarButtonStyle}" Content="Next" Margin="2,0" Padding="8,4" Click="BtnFindNext_Click"/>
                </StackPanel>

                <Button Grid.Column="4" Style="{StaticResource ToolbarButtonStyle}" Content="✕" Padding="8,3" Click="BtnCloseSearch_Click" ToolTip="Close search (Esc)"/>
            </Grid>
        </Border>

        <!-- Main Display: WebView2 & Empty State -->
        <Grid Grid.Row="2">
            <!-- Empty State / Dropzone (Shown when no tab is open) - Styled like mdtopdf.pro upload card -->
            <Border x:Name="EmptyStateOverlay" Background="#09090B" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Visible">
                <Border BorderBrush="#27272A" BorderThickness="1.5" CornerRadius="16" Margin="48" Background="#121215" MaxWidth="640" MaxHeight="430" Padding="40,32" VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- Icon Circle -->
                        <Border Width="64" Height="64" CornerRadius="16" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,18">
                            <TextBlock Text="M↓" Foreground="#FAFAFA" FontWeight="Bold" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="Upload Markdown File" Foreground="#FAFAFA" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="Drag and drop any Markdown (.md, .markdown, .txt) file here, or click to browse" Foreground="#A1A1AA" FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,24"/>

                        <!-- Action Buttons -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,24">
                            <!-- High Contrast Select File Button (mdtopdf.pro style) -->
                            <Button Padding="20,10" FontSize="13" FontWeight="SemiBold" Cursor="Hand" Click="BtnOpen_Click" Margin="0,0,12,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Border" Background="#FAFAFA" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="📂 " FontSize="14"/>
                                                <TextBlock Text="Select Markdown File" Foreground="#09090B" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#E4E4E7"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#D4D4D8"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button Style="{StaticResource ToolbarButtonStyle}" Padding="16,10" FontSize="13" Click="BtnSettings_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚙️ " FontSize="13"/>
                                    <TextBlock Text="Settings &amp; Integration"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Feature Badges -->
                        <WrapPanel HorizontalAlignment="Center" Margin="0,0,0,16">
                            <Border Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="12" Padding="10,4" Margin="4">
                                <TextBlock Text="GFM Tables &amp; Lists" Foreground="#A1A1AA" FontSize="11"/>
                            </Border>
                            <Border Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="12" Padding="10,4" Margin="4">
                                <TextBlock Text="Clean PDF Export" Foreground="#A1A1AA" FontSize="11"/>
                            </Border>
                            <Border Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="12" Padding="10,4" Margin="4">
                                <TextBlock Text="Neutral Zinc Dark Theme" Foreground="#A1A1AA" FontSize="11"/>
                            </Border>
                            <Border Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="12" Padding="10,4" Margin="4">
                                <TextBlock Text="Explorer 'Open with'" Foreground="#A1A1AA" FontSize="11"/>
                            </Border>
                        </WrapPanel>

                        <TextBlock Text="💡 Tip: You can also right-click any .md file in Windows Explorer and select 'Open with MarkRead'." 
                                   Foreground="#71717A" FontSize="11" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Border>

            <!-- Microsoft WebView2 Control -->
            <wv2:WebView2 x:Name="WebViewControl" Visibility="Collapsed" CoreWebView2InitializationCompleted="WebViewControl_CoreWebView2InitializationCompleted"/>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="3" Background="#09090B" BorderBrush="#27272A" BorderThickness="0,1,0,0" Padding="14,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusFilePath" Grid.Column="0" Text="Ready" Foreground="#71717A" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusDocInfo" Text="" Foreground="#71717A" FontSize="11" Margin="0,0,12,0"/>
                    <Border Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="4" Padding="6,2">
                        <TextBlock x:Name="StatusMode" Text="Rendered" Foreground="#E4E4E7" FontSize="10" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
