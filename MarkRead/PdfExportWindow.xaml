<Window x:Class="MarkRead.PdfExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="Export PDF Preview - MarkRead"
        Height="820" Width="1180"
        MinHeight="600" MinWidth="850"
        WindowStartupLocation="CenterOwner"
        Background="#09090B"
        Foreground="#F4F4F5"
        FontFamily="-apple-system, BlinkMacSystemFont, 'Segoe UI', 'Noto Sans', Helvetica, Arial, sans-serif"
        Closed="Window_Closed">

    <Window.Resources>
        <!-- Modern ScrollViewer style -->
        <Style x:Key="ModernScrollViewerStyle" TargetType="{x:Type ScrollViewer}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollViewer}">
                        <Grid>
                            <ScrollContentPresenter />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar Label Style -->
        <Style x:Key="SidebarSectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#A1A1AA"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,16,0,8"/>
        </Style>

        <!-- Common Button Style -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#18181B"/>
            <Setter Property="Foreground" Value="#F4F4F5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#27272A"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#27272A"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#3F3F46"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#3F3F46"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Action Button Style (mdtopdf.pro style) -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FAFAFA"/>
            <Setter Property="Foreground" Value="#09090B"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#E4E4E7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#D4D4D8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#27272A"/>
                                <Setter Property="Foreground" Value="#71717A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark TextBox Style -->
        <Style x:Key="DarkTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#121215"/>
            <Setter Property="Foreground" Value="#FAFAFA"/>
            <Setter Property="BorderBrush" Value="#27272A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CaretBrush" Value="#FAFAFA"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="BoxBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#3F3F46"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark ComboBox Style -->
        <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#121215"/>
            <Setter Property="Foreground" Value="#FAFAFA"/>
            <Setter Property="BorderBrush" Value="#27272A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- Dark CheckBox Style -->
        <Style x:Key="DarkCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#D4D4D8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- RadioButton Style -->
        <Style x:Key="DarkRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#D4D4D8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Segmented Pill RadioButton Style -->
        <Style x:Key="SegmentedRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="PillBorder" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" 
                                CornerRadius="6" Padding="10,7" Margin="2,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="#27272A"/>
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="#2563EB"/>
                                <Setter TargetName="PillBorder" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Left/Center: Live PDF Preview -->
            <ColumnDefinition Width="*"/>
            <!-- Right: Export & Route Configuration Sidebar -->
            <ColumnDefinition Width="380" MinWidth="340" MaxWidth="500"/>
        </Grid.ColumnDefinitions>

        <!-- PDF Preview Panel -->
        <Grid Grid.Column="0" Background="#09090B">
            <!-- Header bar for preview -->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Preview Top Info Bar -->
            <Border Grid.Row="0" Background="#09090B" BorderBrush="#27272A" BorderThickness="0,0,1,1" Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📄 " FontSize="14"/>
                        <TextBlock Text="Live PDF Print Preview" FontWeight="SemiBold" FontSize="13" Foreground="#FAFAFA"/>
                        <TextBlock Text=" (Publication layout)" FontSize="12" Foreground="#71717A" Margin="6,1,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtPreviewStatus" Text="Rendering preview..." Foreground="#A1A1AA" FontSize="11" Margin="0,0,10,0"/>
                        <Button Style="{StaticResource SecondaryButtonStyle}" Padding="8,4" FontSize="11" Click="BtnRefreshPreview_Click" ToolTip="Force reload preview">
                            <TextBlock Text="🔄 Refresh"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Live WebView2 PDF Display -->
            <Grid Grid.Row="1">
                <wv2:WebView2 x:Name="PreviewWebView" 
                              CoreWebView2InitializationCompleted="PreviewWebView_CoreWebView2InitializationCompleted"
                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

                <!-- Loading Spinner / Overlay -->
                <Border x:Name="LoadingOverlay" Background="#B009090B" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Visible">
                    <Border Background="#121215" BorderBrush="#27272A" BorderThickness="1" CornerRadius="8" Padding="20,16" 
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⏳ " FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtLoadingMessage" Text="Generating live PDF preview..." Foreground="#FAFAFA" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Border>
            </Grid>
        </Grid>

        <!-- Right Configuration Sidebar -->
        <Border Grid.Column="1" Background="#121215" BorderBrush="#27272A" BorderThickness="1,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Sidebar Header -->
                    <RowDefinition Height="Auto"/>
                    <!-- Scrollable Settings -->
                    <RowDefinition Height="*"/>
                    <!-- Bottom Action Buttons -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Sidebar Header -->
                <Border Grid.Row="0" BorderBrush="#27272A" BorderThickness="0,0,0,1" Padding="20,14">
                    <StackPanel>
                        <TextBlock Text="PDF Export Settings" FontWeight="Bold" FontSize="16" Foreground="#FAFAFA"/>
                        <TextBlock Text="Review the preview and select your destination route" Foreground="#A1A1AA" FontSize="12" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Scrollable Settings Content -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20,10,20,16">
                    <StackPanel>
                        <!-- Section: Export Route / Path Selection -->
                        <TextBlock Text="EXPORT ROUTE (DESTINATION FILE)" Style="{StaticResource SidebarSectionHeaderStyle}" Margin="0,4,0,8"/>
                        <Border Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="8" Padding="14,12">
                            <StackPanel>
                                <TextBlock Text="Target Path:" Foreground="#A1A1AA" FontSize="11" Margin="0,0,0,6"/>
                                <TextBox x:Name="TxtRoutePath" Style="{StaticResource DarkTextBoxStyle}" 
                                         ToolTip="Destination file path for the exported PDF" 
                                         TextChanged="TxtRoutePath_TextChanged"/>

                                <Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,10,0,0" HorizontalAlignment="Stretch" Click="BtnBrowseRoute_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📁 " FontSize="13"/>
                                        <TextBlock Text="Choose Export Route..." FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                                
                                <TextBlock x:Name="TxtRouteStatus" Text="Route valid" Foreground="#34D399" FontSize="11" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Section: Page Orientation -->
                        <TextBlock Text="PAGE ORIENTATION" Style="{StaticResource SidebarSectionHeaderStyle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <RadioButton x:Name="RbPortrait" Grid.Column="0" Content="📄 Portrait" 
                                         Style="{StaticResource SegmentedRadioButtonStyle}" IsChecked="True" Checked="SettingChanged" GroupName="OrientationGroup"/>
                            <RadioButton x:Name="RbLandscape" Grid.Column="1" Content="📃 Landscape" 
                                         Style="{StaticResource SegmentedRadioButtonStyle}" Checked="SettingChanged" GroupName="OrientationGroup"/>
                        </Grid>

                        <!-- Section: Paper Size -->
                        <TextBlock Text="PAPER SIZE" Style="{StaticResource SidebarSectionHeaderStyle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <RadioButton x:Name="RbPaperA4" Grid.Column="0" Content="A4" 
                                         Style="{StaticResource SegmentedRadioButtonStyle}" IsChecked="True" Checked="SettingChanged" GroupName="PaperSizeGroup" ToolTip="210 × 297 mm"/>
                            <RadioButton x:Name="RbPaperLetter" Grid.Column="1" Content="Letter" 
                                         Style="{StaticResource SegmentedRadioButtonStyle}" Checked="SettingChanged" GroupName="PaperSizeGroup" ToolTip="8.5 × 11 in"/>
                            <RadioButton x:Name="RbPaperLegal" Grid.Column="2" Content="Legal" 
                                         Style="{StaticResource SegmentedRadioButtonStyle}" Checked="SettingChanged" GroupName="PaperSizeGroup" ToolTip="8.5 × 14 in"/>
                        </Grid>

                        <!-- Section: Margins -->
                        <TextBlock Text="PAGE MARGINS" Style="{StaticResource SidebarSectionHeaderStyle}"/>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <RadioButton x:Name="RbMarginStandard" Grid.Row="0" Grid.Column="0" Content="Standard (0.5″)" 
                                         Style="{StaticResource SegmentedRadioButtonStyle}" IsChecked="True" Checked="SettingChanged" GroupName="MarginsGroup"/>
                            <RadioButton x:Name="RbMarginCompact" Grid.Row="0" Grid.Column="1" Content="Compact (0.25″)" 
                                         Style="{StaticResource SegmentedRadioButtonStyle}" Checked="SettingChanged" GroupName="MarginsGroup"/>
                            <RadioButton x:Name="RbMarginWide" Grid.Row="1" Grid.Column="0" Content="Wide (0.8″)" 
                                         Style="{StaticResource SegmentedRadioButtonStyle}" Checked="SettingChanged" GroupName="MarginsGroup"/>
                            <RadioButton x:Name="RbMarginNone" Grid.Row="1" Grid.Column="1" Content="Zero Margin" 
                                         Style="{StaticResource SegmentedRadioButtonStyle}" Checked="SettingChanged" GroupName="MarginsGroup"/>
                        </Grid>

                        <!-- Section: Visual Options -->
                        <TextBlock Text="DOCUMENT APPEARANCE" Style="{StaticResource SidebarSectionHeaderStyle}"/>
                        <Border Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="8" Padding="14,10">
                            <StackPanel>
                                <CheckBox x:Name="ChkBackgrounds" Content="Print background graphics &amp; code styling" 
                                          Style="{StaticResource DarkCheckBoxStyle}" IsChecked="True" Checked="SettingChanged" Unchecked="SettingChanged"/>
                                <CheckBox x:Name="ChkHeaderFooter" Content="Include browser URL / date headers" 
                                          Style="{StaticResource DarkCheckBoxStyle}" IsChecked="False" Checked="SettingChanged" Unchecked="SettingChanged"/>
                            </StackPanel>
                        </Border>

                        <!-- Section: Document Theme -->
                        <TextBlock Text="EXPORT THEME" Style="{StaticResource SidebarSectionHeaderStyle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <RadioButton x:Name="RbThemeClean" Grid.Column="0" Content="☀️ Clean Print" 
                                         Style="{StaticResource SegmentedRadioButtonStyle}" IsChecked="True" Checked="SettingChanged" GroupName="ThemeGroup" ToolTip="White paper layout"/>
                            <RadioButton x:Name="RbThemeDark" Grid.Column="1" Content="🌙 Dark Mode" 
                                         Style="{StaticResource SegmentedRadioButtonStyle}" Checked="SettingChanged" GroupName="ThemeGroup" ToolTip="Dark background layout"/>
                        </Grid>

                        <!-- Information Note -->
                        <Border Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,16,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="ℹ️ " FontSize="12" Margin="0,1,4,0"/>
                                <TextBlock Text="The output is generated as a clean, publication-ready PDF file saved to your chosen route." 
                                           Foreground="#A1A1AA" FontSize="11" TextWrapping="Wrap" MaxWidth="300"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Bottom Action Controls -->
                <Border Grid.Row="2" Background="#09090B" BorderBrush="#27272A" BorderThickness="0,1,0,0" Padding="20,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="Cancel" IsCancel="True" Style="{StaticResource SecondaryButtonStyle}" Click="BtnCancel_Click" Width="85"/>

                        <Button x:Name="BtnExport" Grid.Column="2" Style="{StaticResource PrimaryButtonStyle}" Click="BtnExport_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📥 " FontSize="13"/>
                                <TextBlock Text="Export PDF" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Post-Export Success Modal Overlay -->
        <Border x:Name="ExportSuccessOverlay" Grid.ColumnSpan="2" Background="#D009090B" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Collapsed">
            <Border Background="#121215" BorderBrush="#27272A" BorderThickness="1" CornerRadius="12" Padding="32,28" 
                    HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="🎉" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock Text="PDF Exported Successfully!" Foreground="#FAFAFA" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock Text="Your document has been saved to the selected route:" Foreground="#A1A1AA" FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,14"/>

                    <Border Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,24">
                        <TextBlock x:Name="TxtSuccessFilePath" Text="C:\path\to\document.pdf" Foreground="#E4E4E7" FontSize="12" TextWrapping="Wrap" MaxWidth="480"/>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Style="{StaticResource PrimaryButtonStyle}" Padding="16,10" Margin="0,0,10,0" Click="BtnOpenPdf_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📄 " FontSize="14"/>
                                <TextBlock Text="Open PDF" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SecondaryButtonStyle}" Padding="14,10" Margin="0,0,10,0" Click="BtnShowInFolder_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📁 " FontSize="14"/>
                                <TextBlock Text="Show in Folder"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="Done" Padding="18,10" Click="BtnDone_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
