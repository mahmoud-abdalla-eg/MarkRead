# ==========================================
# MarkRead - Root .gitignore
# ==========================================

# ------------------------------------------
# .NET / Visual Studio Build Artifacts
# ------------------------------------------
**/[Bb]in/
**/[Oo]bj/
*.suo
*.user
*.userosscache
*.sln.docstates
*.DotSettings.user
*.pdb
*.cache
*.vspscc
*.vssscc

# Visual Studio / Rider directories
.vs/
.idea/

# ------------------------------------------
# Node / React / Vite Web Artifacts
# ------------------------------------------
**/node_modules/
**/dist/
**/dist-ssr/
**/.vite-temp/
**/.tmp/
*.local
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ------------------------------------------
# Editor directories and files
# ------------------------------------------
.vscode/*
!.vscode/extensions.json

# ------------------------------------------
# Operating System files
# ------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
